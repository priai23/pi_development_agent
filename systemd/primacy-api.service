[Unit]
Description=Primacy ERP Implementation Agent - API Service
After=network.target postgresql.service
PartOf=primacy.target

[Service]
Type=simple
User=primacy
Group=primacy
WorkingDirectory=/opt/primacy/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/primacy/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5s
KillMode=process
LimitNOFILE=65536

[Install]
WantedBy=primacy.target
