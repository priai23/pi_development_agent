[Unit]
Description=Primacy ERP Implementation Agent - Background Worker
After=network.target postgresql.service primacy-api.service
PartOf=primacy.target

[Service]
Type=simple
User=primacy
Group=primacy
WorkingDirectory=/opt/primacy/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/primacy/backend/venv/bin/python worker.py
Restart=always
RestartSec=5s
KillMode=process
LimitNOFILE=65536

[Install]
WantedBy=primacy.target
