<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_primacy_deployment_job_list" model="ir.ui.view">
        <field name="name">primacy.deployment.job.list</field>
        <field name="model">primacy.deployment.job</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="job_uuid"/>
                <field name="operation"/>
                <field name="module_name"/>
                <field name="module_version"/>
                <field name="status"/>
                <field name="runner_id"/>
            </list>
        </field>
    </record>
    <record id="action_primacy_deployment_jobs" model="ir.actions.act_window">
        <field name="name">Deployment Jobs</field>
        <field name="res_model">primacy.deployment.job</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_primacy_deployment_root" name="Primacy Deployments" groups="base.group_system" sequence="90"/>
    <menuitem id="menu_primacy_deployment_jobs" parent="menu_primacy_deployment_root" action="action_primacy_deployment_jobs" sequence="10"/>
</odoo>
