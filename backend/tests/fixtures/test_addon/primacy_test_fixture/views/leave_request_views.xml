<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leave_request_form" model="ir.ui.view">
        <field name="name">primacy.leave.request.form</field>
        <field name="model">primacy.leave.request</field>
        <field name="arch" type="xml">
            <form string="Leave Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="state != 'submitted'"/>
                    <button name="action_refuse" string="Refuse" type="object"
                            invisible="state not in ('submitted', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,refused"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="leave_type_id"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="duration_days" readonly="1"/>
                    </group>
                    <field name="reason"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_leave_request_list" model="ir.ui.view">
        <field name="name">primacy.leave.request.list</field>
        <field name="model">primacy.leave.request</field>
        <field name="arch" type="xml">
            <list string="Leave Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="duration_days"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_leave_request" model="ir.actions.act_window">
        <field name="name">Leave Requests</field>
        <field name="res_model">primacy.leave.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
